# Application Configuration
APP_NAME="skeleton-fast-api"
APP_ENV="dev" # dev | staging | prod | test
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS
ALLOWED_ORIGINS='["*"]'

# Logging: none (stdout console)
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_MODE="none"

# Authentication: none | basic | oidc
AUTH_MODE="none"

# Basic Authentication (Used when AUTH_MODE=basic)
BASIC_AUTH_USERNAME="admin"
BASIC_AUTH_PASSWORD="admin_password"  # betterleaks:allow

# OIDC Authentication (Used when AUTH_MODE=oidc)
OIDC_ISSUER_URL="https://auth.example.com/realms/myrealm"
OIDC_CLIENT_ID="my-fastapi-service"
OIDC_SSL=true

# Cron / Scheduled Jobs
CRON_ENABLED=true
CRON_HEARTBEAT_INTERVAL=60 # in seconds

# Payload / Size Limits (in bytes)
MAX_REQUEST_SIZE=10485760 # 10MB global fallback
MAX_JSON_SIZE=1048576 # 1MB JSON limit
MAX_UPLOAD_SIZE=20971520 # 20MB multipart/document limit

# JSON Configuration File (optional path override)
# CONFIG_PATH="config.json"
